#include <SPI.h>
#include <RF24.h>
#include <IRremote.hpp>
#include <SoftwareSerial.h>
#include <TinyGPSPlus.h>

// -------------------- Контакты связи и датчиков --------------------
constexpr uint8_t NRF_CE_PIN  = 9;
constexpr uint8_t NRF_CSN_PIN = 10;
constexpr uint8_t GPS_RX_PIN  = 4;   // Сюда подключается TX модуля GPS
constexpr uint8_t GPS_TX_PIN  = A0;  // Свободный пин (не подключается)
constexpr uint8_t IR_PIN      = A1;

// -------------------- Контакты моторов (ШИМ + Цифровые) --------------------
constexpr uint8_t ENA_L = 6;   // ШИМ левого мотора (~D6)
constexpr uint8_t IN3   = 7;   // Цифровой D7
constexpr uint8_t IN4   = 8;   // Цифровой D8

constexpr uint8_t ENA_R = 5;   // ШИМ правого мотора (~D5)
constexpr uint8_t IN1   = 2;   // Цифровой D2
constexpr uint8_t IN2   = 3;   // Цифровой D3

const uint8_t RADIO_ADDRESS[6] = "TLM01";

RF24 radio(NRF_CE_PIN, NRF_CSN_PIN);
SoftwareSerial gpsSerial(GPS_RX_PIN, GPS_TX_PIN);
TinyGPSPlus gps;

// -------------------- Коды действий моторов --------------------
enum MotorAction : uint8_t {
  ACT_STOP       = 0,
  ACT_FORWARD    = 1,
  ACT_BACKWARD   = 2,
  ACT_TURN_RIGHT = 3,
  ACT_TURN_LEFT  = 4,
  ACT_AUTOPILOT  = 5
};

// -------------------- Структуры пакетов --------------------
struct __attribute__((packed)) TelemetryPacket {
  uint8_t protocolVersion;
  uint8_t mode;
  uint8_t motorAction;
  int16_t leftSpeed;
  int16_t rightSpeed;
  uint16_t sequence;
  int32_t latitudeE6;
  int32_t longitudeE6;
  uint8_t satellites;
  uint8_t currentWp;
  uint8_t totalWp;
};

struct __attribute__((packed)) CommandPacket {
  uint8_t cmdType;
  uint8_t wpIndex;
  uint8_t wpTotal;
  int32_t targetLatE6;
  int32_t targetLonE6;
};

// -------------------- Переменные состояния --------------------
struct Waypoint {
  double lat;
  double lon;
};

constexpr uint8_t MAX_WAYPOINTS = 20;
Waypoint route[MAX_WAYPOINTS];
uint8_t totalWaypoints = 0;
uint8_t currentWaypoint = 0;

uint8_t robotMode = 0;
uint8_t currentMotorAction = ACT_STOP;
int16_t currentLeftSpd = 0;
int16_t currentRightSpd = 0;

int baseSpeed = 250; 
uint16_t packetSeq = 0;
uint32_t lastSendMs = 0;

// -------------------- Физическое управление моторами --------------------
void driveMotors(int leftSpd, int rightSpd, uint8_t action) {
  leftSpd  = constrain(leftSpd, -250, 250);
  rightSpd = constrain(rightSpd, -250, 250);

  currentLeftSpd = leftSpd;
  currentRightSpd = rightSpd;
  currentMotorAction = action;

  // Левый мотор (ENA_L с ШИМ, IN3 и IN4 цифровые)
  if (leftSpd > 0) {
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, HIGH);
    analogWrite(ENA_L, leftSpd);
  } else if (leftSpd < 0) {
    digitalWrite(IN3, HIGH);
    digitalWrite(IN4, LOW);
    analogWrite(ENA_L, -leftSpd);
  } else {
    digitalWrite(IN3, LOW);
    digitalWrite(IN4, LOW);
    analogWrite(ENA_L, 0);
  }

  // Правый мотор (ENA_R с ШИМ, IN1 и IN2 цифровые)
  if (rightSpd > 0) {
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, HIGH);
    analogWrite(ENA_R, rightSpd);
  } else if (rightSpd < 0) {
    digitalWrite(IN1, HIGH);
    digitalWrite(IN2, LOW);
    analogWrite(ENA_R, -rightSpd);
  } else {
    digitalWrite(IN1, LOW);
    digitalWrite(IN2, LOW);
    analogWrite(ENA_R, 0);
  }
}

void stopMotors() {
  driveMotors(0, 0, ACT_STOP);
}

// -------------------- ИК-пульт --------------------
void handleIR() {
  if (IrReceiver.decode()) {
    unsigned long value = IrReceiver.decodedIRData.decodedRawData;

    if (value != 0) {
      Serial.print(F("IR Code: "));
      Serial.println(value);

      // Кнопка ВПЕРЕД
      if (value == 3108437760 || value == 2816038240 || value == 631595518 || value == 210258716) {
        robotMode = 0;
        driveMotors(baseSpeed, baseSpeed, ACT_FORWARD);
        Serial.println(F("CMD: ВПЕРЕД"));
      } 
      // Кнопка НАЗАД
      else if (value == 3927310080 || value == 1508897005) {
        robotMode = 0;
        driveMotors(-baseSpeed, -baseSpeed, ACT_BACKWARD);
        Serial.println(F("CMD: НАЗАД"));
      } 
      // Кнопка НАПРАВО
      else if (value == 3158572800 || value == 3122844936) {
        robotMode = 0;
        driveMotors(baseSpeed, 0, ACT_TURN_RIGHT);
        Serial.println(F("CMD: НАПРАВО"));
      } 
      // Кнопка НАЛЕВО
      else if (value == 3141861120 || value == 3943839993) {
        robotMode = 0;
        driveMotors(0, baseSpeed, ACT_TURN_LEFT);
        Serial.println(F("CMD: НАЛЕВО"));
      } 
      // Кнопка СТОП
      else if (value == 3208707840 || value == 3622325019) {
        robotMode = 0;
        stopMotors();
        Serial.println(F("CMD: СТОП"));
      }
    }
    IrReceiver.resume();
  }
}

// -------------------- Автопилот по GPS --------------------
void runAutopilot() {
  if (!gps.location.isValid() || totalWaypoints == 0) {
    stopMotors();
    return;
  }

  double curLat = gps.location.lat();
  double curLon = gps.location.lng();
  double tgtLat = route[currentWaypoint].lat;
  double tgtLon = route[currentWaypoint].lon;

  double distMeters = TinyGPSPlus::distanceBetween(curLat, curLon, tgtLat, tgtLon);

  if (distMeters < 3.0) {
    currentWaypoint++;
    if (currentWaypoint >= totalWaypoints) {
      robotMode = 0;
      stopMotors();
      Serial.println(F("AUTO: Маршрут завершен!"));
      return;
    }
    tgtLat = route[currentWaypoint].lat;
    tgtLon = route[currentWaypoint].lon;
  }

  double courseToTarget = TinyGPSPlus::courseTo(curLat, curLon, tgtLat, tgtLon);
  double currentCourse  = gps.course.deg();

  double angleDiff = courseToTarget - currentCourse;
  if (angleDiff > 180.0)  angleDiff -= 360.0;
  if (angleDiff < -180.0) angleDiff += 360.0;

  int turn = constrain(static_cast<int>(angleDiff * 1.0), -40, 40);
  driveMotors(baseSpeed + turn, baseSpeed - turn, ACT_AUTOPILOT);
}

// -------------------- Setup --------------------
void setup() {
  Serial.begin(115200);
  gpsSerial.begin(9600);

  pinMode(ENA_L, OUTPUT);
  pinMode(IN3, OUTPUT);
  pinMode(IN4, OUTPUT);
  pinMode(ENA_R, OUTPUT);
  pinMode(IN1, OUTPUT);
  pinMode(IN2, OUTPUT);
  stopMotors();

  IrReceiver.begin(IR_PIN);

  radio.begin();
  radio.setChannel(76);
  radio.setDataRate(RF24_1MBPS);
  radio.setPALevel(RF24_PA_HIGH);
  radio.setRetries(5, 15);
  radio.setCRCLength(RF24_CRC_16);

  radio.enableDynamicPayloads();
  radio.enableAckPayload();

  radio.openWritingPipe(RADIO_ADDRESS);
  radio.stopListening();
  Serial.println(F("NRF24: READY"));
}

// -------------------- Loop --------------------
void loop() {
  while (gpsSerial.available() > 0) {
    gps.encode(gpsSerial.read());
  }

  handleIR();

  if (robotMode == 1) {
    runAutopilot();
  }

  const uint32_t now = millis();
  if (now - lastSendMs >= 400) {
    lastSendMs = now;

    TelemetryPacket tlm;
    tlm.protocolVersion = 1;
    tlm.mode = robotMode;
    tlm.motorAction = currentMotorAction;
    tlm.leftSpeed = currentLeftSpd;
    tlm.rightSpeed = currentRightSpd;
    tlm.sequence = packetSeq++;
    tlm.latitudeE6  = gps.location.isValid() ? static_cast<int32_t>(gps.location.lat() * 1000000.0) : 0;
    tlm.longitudeE6 = gps.location.isValid() ? static_cast<int32_t>(gps.location.lng() * 1000000.0) : 0;
    tlm.satellites  = gps.satellites.isValid() ? gps.satellites.value() : 0;
    tlm.currentWp   = currentWaypoint;
    tlm.totalWp     = totalWaypoints;

    if (radio.write(&tlm, sizeof(tlm))) {
      while (radio.available()) {
        CommandPacket cmd;
        radio.read(&cmd, sizeof(cmd));

        if (cmd.cmdType == 1 && cmd.wpIndex < MAX_WAYPOINTS) {
          route[cmd.wpIndex].lat = cmd.targetLatE6 / 1000000.0;
          route[cmd.wpIndex].lon = cmd.targetLonE6 / 1000000.0;
          totalWaypoints = cmd.wpTotal;
          Serial.print(F("RX WP #"));
          Serial.println(cmd.wpIndex + 1);
        } else if (cmd.cmdType == 2 && totalWaypoints > 0) {
          currentWaypoint = 0;
          robotMode = 1;
          Serial.println(F("AUTO: СТАРТ"));
        } else if (cmd.cmdType == 3) {
          robotMode = 0;
          stopMotors();
          Serial.println(F("AUTO: СТОП"));
        }
      }
    }
  }
}
